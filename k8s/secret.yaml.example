# Copy to secret.yaml (do not commit) or create via:
#   kubectl create secret generic mcp-secrets \
#     --namespace mcp-servers \
#     --from-literal=MCP_AUTH_TOKEN=your-token-here
#
# GitHub Actions deploy workflow creates this secret from the MCP_AUTH_TOKEN
# repository secret when set.
apiVersion: v1
kind: Secret
metadata:
  name: mcp-secrets
  namespace: mcp-servers
  labels:
    app.kubernetes.io/name: mcp-servers
type: Opaque
stringData:
  MCP_AUTH_TOKEN: "replace-me"
